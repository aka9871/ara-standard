{
  "$ara_actions": "1.0",
  "intents": {
    "description": "Maps user intents to FlowBoard actions",
    "mappings": [
      {
        "intent": "compare_plans",
        "description": "User wants pricing or plan limits",
        "examples": [
          "How much is the Business plan?",
          "Which plan includes SSO?"
        ],
        "action": "list_plans"
      },
      {
        "intent": "create_task",
        "description": "User wants to add a task to a project",
        "examples": [
          "Add a task 'Prepare Q3 review' to the Website project"
        ],
        "action": "create_project_task"
      },
      {
        "intent": "find_docs",
        "description": "User needs help using the product",
        "examples": [
          "How do I set up a Kanban board?"
        ],
        "action": "list_docs"
      }
    ]
  },
