{
  "$ara_actions": "1.0",
  "intents": {
    "description": "Maps user intents to ByteWire actions",
    "mappings": [
      {
        "intent": "find_article",
        "description": "User is looking for coverage of a subject",
        "examples": [
          "Latest news about AI chips",
          "What did ByteWire write about the new MacBook?"
        ],
        "action": "search_articles"
      },
      {
        "intent": "whats_trending",
        "description": "User wants the stories everyone is reading",
        "examples": [
          "What's trending in tech today?"
        ],
        "action": "get_trending"
      },
      {
        "intent": "author_profile",
        "description": "User wants to know about a journalist",
        "examples": [
          "Who covers cybersecurity at ByteWire?"
        ],
        "action": "list_authors"
      }
    ]
  },
  "actions": [
    {
      "id": "list_articles",
      "name": "GET /articles",
      "description": "List articles with filters and pagination",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "author_id": {
            "type": "string"
          },
          "tags": {
            "type": "array"
          },
          "search": {
            "type": "string"
          },
          "sort": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array"
          },
          "total": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        }
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/articles",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "get_article",
      "name": "GET /articles/{article_id}",
      "description": "Get full article content by ID or slug",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "required": [
          "article_id"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "description": "Article identifier"
          }
        }
      },
      "output": {
        "$ref": "schemas/articles.json"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/articles/{article_id}",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "list_article_comments",
      "name": "GET /articles/{article_id}/comments",
      "description": "Get article comments or post new comment (GET)",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "required": [
          "article_id"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "description": "Article identifier"
          },
          "approved_only": {
            "type": "boolean"
          },
          "sort": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "output": {
        "type": "object"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/articles/{article_id}/comments",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "create_article_comment",
      "name": "POST /articles/{article_id}/comments",
      "description": "Get article comments or post new comment (POST)",
      "type": "mutation",
      "idempotent": false,
      "auth_required": false,
      "confirmation_required": false,
      "input": {
        "type": "object",
        "required": [
          "article_id"
        ],
        "properties": {
          "article_id": {
            "type": "string",
            "description": "Article identifier"
          },
          "approved_only": {
            "type": "boolean"
          },
          "sort": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "output": {
        "type": "object"
      },
      "protocols": {
        "rest": {
          "method": "POST",
          "path": "/v1/articles/{article_id}/comments"
        }
      }
    },
    {
      "id": "search_articles",
      "name": "GET /articles/search",
      "description": "Full-text search across article content",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "from_date": {
            "type": "string"
          },
          "to_date": {
            "type": "string"
          },
          "page": {
            "type": "integer"
          }
        }
      },
      "output": {
        "type": "object"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/articles/search",
          "params_mapping": "query_string"
        }
      }
    },
