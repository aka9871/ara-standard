{
  "$ara_actions": "1.0",
  "intents": {
    "description": "Maps user intents to Le Jardin actions",
    "mappings": [
      {
        "intent": "book_table",
        "description": "User wants to reserve a table",
        "examples": [
          "Book a table for two on Friday at 8pm",
          "Is there availability tomorrow evening?"
        ],
        "action": "check_reservations_availability"
      },
      {
        "intent": "see_menu",
        "description": "User wants to know what is served",
        "examples": [
          "What's on the tasting menu?",
          "Do you have vegetarian dishes?"
        ],
        "action": "list_menu"
      },
      {
        "intent": "wine_pairing",
        "description": "User wants a wine recommendation",
        "examples": [
          "Which wine goes with the duck?"
        ],
        "action": "list_wine_list_pairings"
      }
    ]
  },
  "actions": [
    {
      "id": "list_menu",
      "name": "GET /menu",
      "description": "Get current menu with all dishes",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "properties": {
          "course_type": {
            "type": "string"
          },
          "dietary_filter": {
            "type": "array"
          },
          "seasonal_only": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/menu",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "get_dish",
      "name": "GET /menu/{dish_id}",
      "description": "Get detailed dish information",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "required": [
          "dish_id"
        ],
        "properties": {
          "dish_id": {
            "type": "string",
            "description": "Dish identifier"
          }
        }
      },
      "output": {
        "$ref": "schemas/menu.json"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/menu/{dish_id}",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "list_menu_versions",
      "name": "GET /menu-versions",
      "description": "List all menu versions",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "properties": {
          "season": {
            "type": "string"
          },
          "active_only": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "type": "object"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/menu-versions",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "get_menu_version",
      "name": "GET /menu-versions/{version_id}",
      "description": "Get specific menu version details",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "required": [
          "version_id"
        ],
        "properties": {
          "version_id": {
            "type": "string",
            "description": "Version identifier"
          }
        }
      },
      "output": {
        "$ref": "schemas/menu_versions.json"
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/menu-versions/{version_id}",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "check_reservations_availability",
      "name": "GET /reservations/availability",
      "description": "Check table availability for given date and time",
      "type": "query",
      "idempotent": true,
      "auth_required": false,
      "input": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "time": {
            "type": "string"
          },
          "party_size": {
            "type": "integer"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "available_slots": {
            "type": "array"
          },
          "available_tables": {
            "type": "array"
          }
        }
      },
      "protocols": {
        "rest": {
          "method": "GET",
          "path": "/v1/reservations/availability",
          "params_mapping": "query_string"
        }
      }
    },
    {
      "id": "list_reservations",
